INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('U01', 'grading', 'grading scale, grade points, what is an a grade, grade scale', 'NED University follows a 4.0 scale: A (4.0), A- (3.7), B+ (3.4), B (3.0), B- (2.7), C+ (2.4), C (2.0), C- (1.7), D+ (1.4), D (1.0), and F (0.0). D is the minimum passing grade.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('U01', 'grading', 'grading scale kya, grade points kitne, a grade ke kitne points', 'NED mein 4.0 scale chalta hai: A (4.0), A- (3.7), B+ (3.4), B (3.0), B- (2.7), C+ (2.4), C (2.0), C- (1.7), D+ (1.4), D (1.0), aur F (0.0). D minimum passing grade hai.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('U02', 'grading', 'deans list, dean honor, honor list, merit standing, dean''s honor', 'To qualify for the Dean''s Honor Roll, a student must achieve a Semester GPA of 3.50 or higher in a regular semester with zero backlogs and a normal credit load.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('U02', 'grading', 'deans list, honor list, merit list', 'Dean''s Honor Roll ke liye regular semester mein Semester GPA 3.50 ya zyada, koi backlog nahi, aur normal credit load hona chahiye.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('U03', 'prerequisites', 'hardware sequence, hardware path, embedded path, course path embedded', 'The hardware sequence is EE-120 (Basic Electrical) → CS-221 (Logic Design) → CS-219 (Computer Architecture) → CS-320 (Microprocessors) → CS-420 (Embedded Systems).', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
