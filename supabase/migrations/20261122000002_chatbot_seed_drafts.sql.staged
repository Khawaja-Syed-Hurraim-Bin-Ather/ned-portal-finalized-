INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G16', 'fyp', 'fyp examples, example fyp, fyp ideas, past fyp titles, sample fyp', 'Some past FYP titles in the department records: IoT Based Air Pollution Monitoring, Telepresence Robot, AI Enabled Urdu OCR, DeepFake Detection using CNN, Blockchain-Based Degree Verification, and Faster R-CNN Traffic Management.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
