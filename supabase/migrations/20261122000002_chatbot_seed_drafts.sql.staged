INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G07', 'prerequisites', 'failed prereq, fail prerequisite, failed prerequisite, locked course, cannot register course, why is my course locked, prerequisite failed', 'If you fail a prerequisite, the courses that depend on it stay locked until you pass the prerequisite.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G07', 'prerequisites', 'prerequisite fail, prereq fail, course lock kyun, agla course kyun nahi, prerequisite fail to kya', 'Agar prerequisite fail ho jaye to jo courses us par depend karte hain woh us waqt tak lock rehte hain jab tak tum prerequisite pass nahi kar lete.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G08', 'fyp', 'when fyp starts, fyp start, 7th semester fyp, fyp semester, fyp timing, when do i start fyp, fyp duration', 'The Final Year Project is CS-406: Part I runs in Semester 7 and Part II in Semester 8, 3 credit hours each.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G08', 'fyp', 'fyp kab, fyp kis semester, fyp kab start, fyp kitne semester', 'Final Year Project CS-406 hai: Part I Semester 7 mein aur Part II Semester 8 mein hota hai, har part 3 credit hours ka.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G09', 'fyp', 'how to get supervisor, find supervisor, contact professor, who can supervise my fyp, fyp supervisor, get a supervisor', 'Browse faculty profiles in the Professor Directory to match research domains (for example Computer Vision, Cybersecurity, Embedded AI). Draft a concise email with your CV and a 2-line project idea.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G09', 'fyp', 'supervisor kaise, supervisor kaise dhoond, fyp ke liye professor, kis professor se fyp', 'Professor Directory mein faculty ki research areas dekho aur apne project idea se match karo. Phir apna CV aur 2 line ka project idea email kar do.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G10', 'career', 'career tracks, what tracks are there, career paths, which track should i choose, list of tracks', 'There are 12 career tracks: AI & Machine Learning, Data Science & Big Data, Full-Stack Web Development, Cybersecurity & Digital Forensics, Embedded Systems & IoT, Cloud Architecture & DevOps, Mobile App Engineering, Blockchain & Smart Contracts, Computer Vision & Graphics, Bioinformatics & Health Tech, AR/VR & Game Engineering, and Software Quality Assurance & Testing.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G10', 'career', 'career tracks kon se, tracks ki list, career paths, kaun sa track chunun', 'Career tracks 12 hain: AI & Machine Learning, Data Science & Big Data, Full-Stack Web Development, Cybersecurity & Digital Forensics, Embedded Systems & IoT, Cloud Architecture & DevOps, Mobile App Engineering, Blockchain & Smart Contracts, Computer Vision & Graphics, Bioinformatics & Health Tech, AR/VR & Game Engineering, aur Software Quality Assurance & Testing.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G11', 'tools', 'what if simulation, failure simulator, what if simulator, simulate failing a course', 'The What-If Failure Simulator in the Prerequisite Explorer runs entirely in your browser. It never alters your official academic record.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G11', 'tools', 'what if simulator kya, failure simulator, fail simulate kaise', 'What-If Failure Simulator Prerequisite Explorer mein tumhare browser ke andar hi chalta hai. Yeh tumhara official academic record kabhi nahi badalta.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G12', 'fyp', 'fyp credits, how many credits is fyp, credit hours of fyp, cs-406 credits, is fyp 3 credit hours', 'CS-406 (Final Year Project) is 3 credit hours per part: Part I in Semester 7 and Part II in Semester 8.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
