INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G01', 'grading', 'minimum cgpa, cgpa to graduate, cgpa needed, cgpa required, cgpa do i need, passing cgpa, graduation cgpa, lowest cgpa', 'To graduate you need a minimum CGPA of 2.00.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G01', 'grading', 'cgpa kitna, minimum cgpa, kam az kam cgpa, cgpa chahiye, cgpa kitna chahiye', 'Graduate hone ke liye kam az kam 2.00 CGPA chahiye.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G02', 'grading', 'passing grade, minimum passing grade, pass mark, minimum grade to pass, what grade is pass, d grade pass', 'The minimum passing grade is D (1.0 grade point, 50% marks).', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G02', 'grading', 'passing grade kya, pass hone ke liye kya chahiye, minimum grade kya, pass marks kitne, kitne marks pe pass, d grade pass', 'Minimum passing grade D hai (1.0 grade point, yaani 50% marks).', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G03', 'grading', 'retake course, repeat course, which grade counts, improve grade, grade improvement, repeat a failed course, retake a course, retake a subject', 'If you repeat a course, the higher grade replaces the earlier grade in your CGPA calculation.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G03', 'grading', 'course dobara parhna, repeat karna, kaun sa grade count, grade improve, fail course dobara, retake kaise', 'Course repeat karo to CGPA mein higher grade purane grade ki jagah count hota hai.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G04', 'registration', 'max credits, credit limit, maximum credit hours, credit ceiling, how many credits can i take, overload, 21 credits, credit overload', 'The regular maximum is 18 credit hours per semester. An overload of up to 21 credit hours is possible with the Chairman''s approval.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G04', 'registration', 'ek semester mein kitne credit, zyada se zyada credit, credit limit kitni, overload kaise, 21 credit', 'Aam taur par ek semester mein zyada se zyada 18 credit hours le sakte ho. 21 credit hours tak overload Chairman ki manzoori se mumkin hai.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G05', 'program', 'total credit hours, degree credit hours, how many credits in degree, total credits, credits to graduate', 'The degree is 136 credit hours across 8 semesters.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G05', 'program', 'degree mein kul kitne credit, total credit hours kitne, graduate hone ke liye kitne credit', 'Degree 136 credit hours ki hai, jo 8 semesters mein hoti hai.', 'ru', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
INSERT INTO chatbot_answers (intent_id, category, question_pattern, answer_text, language, confidence_threshold, review_status, is_active) VALUES ('G06', 'program', 'how many courses, total courses, number of courses, how many subjects, how many labs', 'The program has 53 courses in total, including theory courses and practical labs.', 'en', 0.85, 'draft', false) ON CONFLICT DO NOTHING;
